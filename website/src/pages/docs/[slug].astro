---
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { allDocs, docSummary, docTitle, type DocEntry } from '../../lib/docs';

export async function getStaticPaths() {
  return (await allDocs()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: DocEntry };
const { Content, headings } = await render(entry);
const file = entry.filePath?.split('/').pop() ?? '';
const source = entry.collection === 'root' ? file : `docs/${file}`;
---
<DocsLayout title={docTitle(entry)} description={docSummary(entry)} slug={entry.id} headings={headings} source={source}>
  <Content />
</DocsLayout>
