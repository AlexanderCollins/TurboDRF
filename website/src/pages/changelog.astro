---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { REPO_URL } from '../lib/site';

const entry = (await getEntry('root', 'changelog'))!;
const { Content } = await render(entry);
---
<Layout title="Changelog" description="What changed in each TurboDRF release." card="docs">
  <div class="docs-page wrap pt-28 pb-10">
    <article class="prose prose-invert prose-turbo mx-auto" data-pagefind-body>
      <Content />
    </article>
    <p class="text-center mt-12 text-sm ink-3">Releases are tagged on <a class="mint" href={`${REPO_URL}/releases`} target="_blank" rel="noopener">GitHub</a> and published to PyPI.</p>
  </div>
</Layout>
