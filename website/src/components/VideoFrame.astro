---
// A rendered clip (tools/video) in a window frame: muted, looping, plays only
// while on screen; the poster stands in without JS or with reduced motion.
interface Props { name: string; title: string; label: string; eager?: boolean; class?: string }
const { name, title, label, eager = false, class: className } = Astro.props;
---
<div class:list={['frame', className]}>
  <div class="frame-bar"><i></i><i></i><i></i><span class="ml-2">{title}</span></div>
  <video
    data-autoplay
    muted
    loop
    playsinline
    preload={eager ? 'auto' : 'none'}
    poster={`/video/${name}.webp`}
    width="1920"
    height="1080"
    aria-label={label}
  >
    <source src={`/video/${name}.webm`} type="video/webm" />
    <source src={`/video/${name}.mp4`} type="video/mp4" />
  </video>
</div>
