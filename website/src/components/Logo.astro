---
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<span class="inline-flex items-center gap-2.5 font-display text-[1.15rem] tracking-tight">
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
    <defs>
      <linearGradient id="logo-g" x1="10" y1="10" x2="54" y2="54" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#6ff2bd" />
        <stop offset="1" stop-color="#38d6f0" />
      </linearGradient>
    </defs>
    <rect x="2" y="2" width="60" height="60" rx="15" fill="#0d1214" />
    <rect x="2.5" y="2.5" width="59" height="59" rx="14.5" fill="none" stroke="url(#logo-g)" stroke-opacity=".45" />
    <path d="M17 19 L30 32 L17 45" fill="none" stroke="url(#logo-g)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M32 19 L45 32 L32 45" fill="none" stroke="url(#logo-g)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" opacity=".55" />
  </svg>
  <span>Turbo<span class="mint">DRF</span></span>
</span>
