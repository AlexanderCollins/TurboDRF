---
import Logo from './Logo.astro';
import { REPO_URL, VERSION } from '../lib/site';
const path = Astro.url.pathname;
const links = [
  { href: '/#security', label: 'Permissions' },
  { href: '/#features', label: 'Features' },
  { href: '/docs/', label: 'Docs' },
  { href: '/changelog/', label: 'Changelog' },
];
const active = (href: string) => (href === '/docs/' ? path.startsWith('/docs/') : path === href);
---
<header class="nav fixed inset-x-0 top-0 z-50">
  <div class="wrap flex items-center justify-between h-16">
    <div class="flex items-center gap-3">
      <a href="/" aria-label="TurboDRF home"><Logo /></a>
      <a href="/changelog/" class="badge badge-sm badge-ghost font-mono hidden sm:inline-flex border-[var(--line)]">v{VERSION}</a>
    </div>
    <nav class="hidden md:flex items-center gap-8 text-sm" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class:list={['transition-colors hover:text-[var(--mint)]', active(l.href) ? 'mint' : 'ink-2']}>{l.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <button type="button" class="btn btn-sm btn-ghost ink-2 hidden sm:inline-flex gap-2 font-normal" data-search-open aria-label="Search the docs">
        <span class="icon-[lucide--search] size-4"></span>
        <kbd class="kbd kbd-xs">⌘K</kbd>
      </button>
      <a href={REPO_URL} class="btn btn-sm btn-ghost ink-2 px-2" aria-label="TurboDRF on GitHub" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
      </a>
      <a href="/docs/quickstart/" class="btn btn-sm btn-primary rounded-full px-4 hidden sm:inline-flex">Get started</a>
      <div class="dropdown dropdown-end md:hidden">
        <button type="button" tabindex="0" class="btn btn-sm btn-ghost px-2" aria-label="Menu"><span class="icon-[lucide--menu] size-5"></span></button>
        <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box z-10 mt-2 w-52 p-2 shadow-xl border border-[var(--line)]">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><button type="button" data-search-open>Search the docs</button></li>
          <li><a href="/docs/quickstart/" class="mint">Get started</a></li>
        </ul>
      </div>
    </div>
  </div>
</header>

<style>
  .nav { transition: background-color .3s, backdrop-filter .3s, border-color .3s; border-bottom: 1px solid transparent; }
  :global(.scrolled) .nav, :global(.docs-page) .nav {
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    backdrop-filter: blur(18px) saturate(1.4);
    border-color: var(--line);
  }
</style>
