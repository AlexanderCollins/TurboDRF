include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include INSTALL.md
include SECURITY.md
include pyproject.toml

# The test suite, with the root conftest.py it needs.
include conftest.py
recursive-include tests *.py
recursive-exclude tests __pycache__
recursive-exclude * *.py[co]
recursive-exclude * .DS_Store

prune example_project
prune website
prune docs
prune .github
prune venv
prune .git
prune .pytest_cache
prune htmlcov
